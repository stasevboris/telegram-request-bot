# Copy this file to .env and fill in your real values.
# Never post .env, BOT_TOKEN, or Google service-account JSON in chats or Git.
BOT_TOKEN=1234567890:replace_with_token_from_BotFather

# Admin numeric Telegram IDs, comma-separated. Temporary bootstrap value 0 lets
# the bot start so /myid can be used; DO NOT accept public requests until changed.
ADMIN_IDS=0

# Optional private admin group: add the bot and grant permission to send messages.
# Admin controls are accepted there only when this group ID is configured.
# ADMIN_CHAT_ID=-1001234567890

# Your public Telegram username without @; displayed as contact and in privacy notice.
CONTACT_USERNAME=borislabs

# Local run: ./data/bot.sqlite3. Docker Compose overrides this to /app/data/bot.sqlite3.
DATABASE_PATH=./data/bot.sqlite3
MAX_ATTACHMENTS=5
MAX_ATTACHMENT_MB=20

# Optional Google Sheets mirror. Leave both blank until configured.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_WORKSHEET=Заявки
SHEETS_SYNC_INTERVAL_SECONDS=300
